@model IEnumerable<ABC_Retail_CloudApp.Models.ProductEntity>

@{
    ViewData["Title"] = "Products";
}

<h2 class="mb-4">Product List</h2>

<!-- ✅ Success / error messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- ✅ Search bar -->
<form asp-action="Index" method="get" class="mb-3 d-flex align-items-center">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
           placeholder="Search by name or category"
           class="form-control me-2" style="max-width:300px;" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
</form>

<!-- ✅ Add new product button -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Add New Product</a>
</div>

<!-- ✅ Product table -->
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price (R)</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="Product Image"
                                 style="width:100px;height:100px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <span>No image</span>
                        }
                    </td>
                    <td>@item.ProductName</td>
                    <td>@item.Category</td>
                    <td>@item.Price.ToString("F2")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No products found.</td>
            </tr>
        }
    </tbody>
</table>
