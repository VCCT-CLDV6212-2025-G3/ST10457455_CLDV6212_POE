@model ABC_Retail_CloudApp.Models.ProductUploadModel

@{
    ViewData["Title"] = "Add Product";
}

<h2>Add New Product</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post" class="p-4 bg-light rounded shadow-sm">
    <div class="form-group mb-3">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="ProductImage" class="form-label">Upload Product Image</label>
        <input asp-for="ProductImage" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Product</button>
</form>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
