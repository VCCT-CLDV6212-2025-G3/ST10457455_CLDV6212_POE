@model IEnumerable<ABC_Retail_CloudApp.Models.CustomerEntity>

@{
    ViewData["Title"] = "Customers";
}

<h2 class="mb-4">Customers</h2>

<a class="btn btn-primary mb-3" asp-action="Create">➕ Add New Customer</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th style="width: 180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FirstName</td>
                <td>@customer.LastName</td>
                <td>@customer.Email</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Edit</a>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
