@model IEnumerable<ABC_Retail_CloudApp.Models.CustomerEntity>

@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<a asp-controller="Customers" asp-action="Create" class="btn btn-primary">Add New Customer</a>

<table class="table table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FirstName</td>
                <td>@customer.LastName</td>
                <td>@customer.Email</td>
            </tr>
        }
    </tbody>
</table>
