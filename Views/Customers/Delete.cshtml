@model ABC_Retail_CloudApp.Models.CustomerEntity

@{
    ViewData["Title"] = "Delete Customer";
}

<h2 class="mb-4 text-danger">Delete Customer</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this customer?</strong>
</div>

<div class="card p-3 shadow-sm">
    <p><strong>First Name:</strong> @Model.FirstName</p>
    <p><strong>Last Name:</strong> @Model.LastName</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

<form method="post" asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="PartitionKey" />
    <input type="hidden" asp-for="RowKey" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
